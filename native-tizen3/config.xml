<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://mojangels.example/MojangelsTV"
        version="0.2.0"
        viewmodes="fullscreen">
  <name>Mojangels AI TV</name>
  <content src="index.html"/>
  <!-- Restrict TV app network access to HTTPS; actual gateway host still requires pairing. -->
  <access origin="https://*" subdomains="true"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:application id="Mojangel01.native-tizen3"
                     package="Mojangel01"
                     required_version="3.0"/>
  <tizen:profile name="tv"/>
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 install-location="auto"
                 hwkey-event="enable"/>
</widget>
